<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Identifies this process to AuthenticationServices. Without it the native
	     security-key ceremony fails at the framework with error 1004, "The calling
	     process does not have an application identifier" — observed live 2026-07-29,
	     which is how this entry came to exist. It is NOT redundant with the embedded
	     provisioning profile: the profile *authorizes* the entitlement, but an
	     entitlement only takes effect when the code signature *claims* it, and Tauri
	     signs with exactly this file and nothing else. [T — reproduced then fixed]

	     Must match the app's Team ID + bundle identifier exactly, and both values must
	     appear in the embedded profile's Entitlements dict or the app will not launch
	     (see docs/macos-associated-domains.md for that failure mode). -->
	<key>com.apple.application-identifier</key>
	<string>8UF87JS6WW.com.ankayma.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>8UF87JS6WW</string>

	<!-- The Touch ID step-up factor keeps its Secure Enclave key in the data protection
	     keychain, which is the only keychain Secure Enclave keys may live in, and which
	     "requires the calling binary to be codesigned with entitlements for the
	     KeychainAccessGroups it is supposed to access"
	     [T:security-framework-3.7.0 src/item.rs Location docs].
	     The embedded provisioning profile grants 8UF87JS6WW.*, so this is authorized. -->
	<key>keychain-access-groups</key>
	<array>
		<string>8UF87JS6WW.com.ankayma.app</string>
	</array>

	<!-- Lets the OS accept "ankayma.com" as the WebAuthn RP ID for this app, by
	     checking it against https://ankayma.com/.well-known/apple-app-site-association
	     (which must declare 8UF87JS6WW.com.ankayma.app under "webcredentials").

	     This is for the NATIVE ceremony — ASAuthorizationSecurityKeyPublicKeyCredential-
	     Provider in gui/src-tauri/src/webauthn_apple.rs. It does NOT enable
	     navigator.credentials in the webview: WKWebView does not support FIDO2 security
	     keys at all, entitlement or not, which is the whole reason the native path
	     exists. See docs/webauthn-security-key-decision.md.
	     [T:developer.apple.com/documentation/xcode/supporting-associated-domains]

	     The second entry is a DIFFERENT service on the same entitlement: `applinks` makes
	     the OS open THIS app for https://cp.ankayma.com/join?token=… instead of a browser,
	     so an invitee who already has the app skips the landing page entirely. It is
	     checked against https://cp.ankayma.com/.well-known/apple-app-site-association,
	     which the control plane serves from a compiled default (no env needed).

	     Both services must be listed together: the OS reads this array as the complete set,
	     so dropping `webcredentials` here would silently break the security-key ceremony
	     while the app still launched and links still opened. Adding a domain needs no new
	     provisioning profile — the embedded Developer ID profile authorizes this entitlement
	     with a wildcard (`com.apple.developer.associated-domains = *`, verified by decoding
	     macos/ankayma-devid.provisionprofile 2026-08-04). What it does NOT survive is the
	     profile going missing; see docs/macos-associated-domains.md §2, and keep the launch
	     gate in scripts/release-macos.sh — every static signature check passed on the two
	     builds this entitlement bricked. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:ankayma.com</string>
		<string>applinks:cp.ankayma.com</string>
	</array>
</dict>
</plist>
